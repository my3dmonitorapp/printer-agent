import os, time, json, math, requests, datetime
from zoneinfo import ZoneInfo

MOONRAKER    = os.getenv("MOONRAKER_URL", "http://127.0.0.1:7125").rstrip("/")
PRINTER_ID   = os.getenv("PRINTER_ID", "printer01")
WEBHOOK_BASE = os.getenv("N8N_WEBHOOK_BASE", "").rstrip("/")
TOKEN        = os.getenv("AGENT_TOKEN", "")
POLL         = int(os.getenv("POLL_SECONDS", "5"))
LOCAL_TZ     = os.getenv("TZ", "UTC")

# Filament conversion config
DIA_MM   = float(os.getenv("FILAMENT_DIAMETER_MM", "1.75"))
RHO      = float(os.getenv("FILAMENT_DENSITY_G_CM3", "1.24"))

WEBHOOK_URL = f"{WEBHOOK_BASE}/{PRINTER_ID}/events"

headers = {"Content-Type": "application/json"}
if TOKEN:
    headers["X-Agent-Token"] = TOKEN

def now_utc_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()

def now_local_iso():
    return datetime.datetime.now(ZoneInfo(LOCAL_TZ)).replace(microsecond=0).isoformat()

def query_print_stats():
    url = f"{MOONRAKER}/printer/objects/query?print_stats&display_status&virtual_sdcard"
    r = requests.get(url, timeout=4)
    r.raise_for_status()
    return r.json().get("result", {}).get("status", {})

def mm_to_grams(length_mm: float, dia_mm: float, rho_g_cm3: float) -> float:
    """Convert filament length (mm) to grams given diameter (mm) & density (g/cm^3)."""
    if length_mm <= 0 or dia_mm <= 0 or rho_g_cm3 <= 0:
        return 0.0
    radius_mm = dia_mm / 2.0
    cross_area_mm2 = math.pi * (radius_mm ** 2)          # mm^2
    volume_mm3 = cross_area_mm2 * length_mm              # mm^3
    volume_cm3 = volume_mm3 / 1000.0                     # cm^3
    grams = volume_cm3 * rho_g_cm3
    return round(grams, 2)

def post_event(event, payload=None):
    data = {
        "event": event,
        "printer_id": PRINTER_ID,
        "timestamp_utc": now_utc_iso(),
        "timestamp_local": now_local_iso(),
    }
    if payload:
        data.update(payload)
    rr = requests.post(WEBHOOK_URL, headers=headers, data=json.dumps(data), timeout=6)
    rr.raise_for_status()
    print(f"POST {event} -> {rr.status_code}")

def main():
    print(f"Agent starting for {PRINTER_ID} -> {WEBHOOK_URL}")
    last_state = None
    last_filename = None
    start_filament_mm = None

    while True:
        try:
            s = query_print_stats()
            ps = s.get("print_stats", {})
            ds = s.get("display_status", {})

            state = ps.get("state")
            filename = (ps.get("filename") or "") or (ds.get("filename") or "")
            filament_used_mm = float(ps.get("filament_used") or 0.0)
            print_duration_s = float(ps.get("print_duration") or ps.get("total_duration") or 0.0)

            # transition: idle/ready -> printing
            if last_state != "printing" and state == "printing":
                start_filament_mm = filament_used_mm
                post_event("print_started", {
                    "filename": filename or "",
                    "material": "",  # optional to fill later
                })

            # transition: printing -> finished/cancelled/error/ready/standby
            if last_state == "printing" and state in ("complete","cancelled","error","standby","ready"):
                delta_mm = 0.0
                if start_filament_mm is not None:
                    delta_mm = max(0.0, filament_used_mm - start_filament_mm)
                grams = mm_to_grams(delta_mm, DIA_MM, RHO)
                duration_min = round(print_duration_s / 60.0, 1) if print_duration_s else ""

                post_event("print_finished", {
                    "filename": filename or last_filename or "",
                    "status": state,
                    "duration_min": duration_min,
                    "filament_mm": round(delta_mm, 1),
                    "filament_g": grams if grams else "",
                })

                # reset baseline after finish
                start_filament_mm = None

            last_state = state
            if filename:
                last_filename = filename

        except Exception as e:
            print(f"poll error: {e}")
        time.sleep(POLL)

if __name__ == "__main__":
    main()
