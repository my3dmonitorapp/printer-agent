# --- Moonraker on your CB1 (default port 7125)
MOONRAKER_URL=http://127.0.0.1:7125

# Your real printer id label (must match what you used in n8n/Sheets)
PRINTER_ID=CHANGE_ME


# ⚠️ This must be a single line (no wraps, no spaces):
N8N_WEBHOOK_BASE=https://app.my3dmonitor.com/webhook/5a8722a5-25b6-4593-ac8f-bad20c53a28e/printers

# Optional shared secret header; leave as-is unless you also check it in n8n
AGENT_TOKEN=CHANGE_ME

# Polling interval seconds
POLL_SECONDS=5

TZ=Asia/Jakarta

FILAMENT_DIAMETER_MM=1.75
FILAMENT_DENSITY_G_CM3=1.24   # PLA ~1.24, PETG ~1.27, ABS ~1.04, ASA ~1.07

MATERIAL_NAME=PLA
